# agent-builder — ตัวแปรที่ live audit (M6) ต้องใช้ ค่าจริงห้าม commit
# thClaws binary ที่ใช้ validate/pack และ start daemon ชั่วคราว (ค่าเริ่มต้น: หาใน PATH)
THCLAWS_BIN=thclaws
# provider key สำหรับ live audit — ไม่มี = package หยุดที่สถานะ draft
ANTHROPIC_API_KEY=
# env ที่ pack ต้องการจะประกาศ "ชื่อ" ไว้ใน pack.yaml ของแต่ละ pack ไม่ใช่ที่นี่
