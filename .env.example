# agent-builder — ตัวแปรที่ live audit (M6) ต้องใช้ ค่าจริงห้าม commit
# thClaws binary ที่ใช้ validate/pack และ start daemon ชั่วคราว (ค่าเริ่มต้น: หาใน PATH)
THCLAWS_BIN=thclaws
# provider key สำหรับ live audit — ไม่มี = package หยุดที่สถานะ draft
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MATCHA_API_KEY=
# env ที่ pack ต้องการจะประกาศ "ชื่อ" ไว้ใน pack.yaml ของแต่ละ pack ไม่ใช่ที่นี่
# ถ้ามีตัวแปร Environment (ENV) ที่ Agent ตัวไหนจำเป็นต้องใช้ตอนทำงาน เราจะไม่มากำหนดในไฟล์ .env หรือ .env.example
# รวมของโปรเจกต์นี้ แต่เราจะไปประกาศชื่อตัวแปรนั้นไว้ในไฟล์ pack.yaml (หรือ manifest) ของ Agent แต่ละตัว (แต่ละ pack) แทน
# ไฟล์ .env นี้มีไว้เพื่อเก็บ Key หรือค่า Setting กลางที่ใช้สำหรับระบบของ agent-builder เอง (เช่น ใช้รันคำสั่ง live audit หรือแพ็กเกจ Agent) เท่านั้น
