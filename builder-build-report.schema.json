{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thclaws.cloud/schemas/agent-builder/builder-build-report.schema.json",
  "title": "Agent Builder build report",
  "description": "Generation evidence (M4) plus the static-audit verdict (M5). Live and security audits are later milestones.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "package_status",
    "target",
    "thclaws_baseline",
    "compatibility",
    "generated_files",
    "declared_permissions",
    "guarantee_matrix",
    "audit",
    "dependencies",
    "deployment_hints"
  ],
  "properties": {
    "format_version": {
      "const": 1
    },
    "package_status": {
      "enum": [
        "unverified",
        "draft"
      ]
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "thclaws_baseline": {
      "type": "string",
      "minLength": 1
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "target",
        "execution_surface",
        "allowed_patterns",
        "package_pattern",
        "flow_location"
      ],
      "properties": {
        "status": {
          "const": "matched"
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "execution_surface": {
          "type": "string",
          "minLength": 1
        },
        "allowed_patterns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "package_pattern": {
          "type": "string",
          "minLength": 1
        },
        "flow_location": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "generated_files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "declared_permissions": {
      "type": "object",
      "description": "Copied from AgentSpec; AgentSpec validation owns its contract."
    },
    "guarantee_matrix": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim",
          "status",
          "basis"
        ],
        "properties": {
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "Declared",
              "Not guaranteed",
              "Enforced",
              "Static check",
              "Not verified",
              "Not applicable",
              "No evidence"
            ]
          },
          "basis": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spec",
        "manifest",
        "static",
        "live",
        "security"
      ],
      "properties": {
        "spec": {
          "enum": [
            "passed",
            "failed"
          ]
        },
        "manifest": {
          "enum": [
            "not_run",
            "passed",
            "failed",
            "skipped"
          ],
          "description": "thclaws agent validate; must equal static_audit.thclaws_validate.status once the static audit ran."
        },
        "static": {
          "enum": [
            "not_run",
            "passed",
            "failed"
          ]
        },
        "live": {
          "const": "not_run"
        },
        "security": {
          "const": "not_run"
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pack",
          "status",
          "mcp_servers"
        ],
        "properties": {
          "pack": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "missing",
              "assets_bundled",
              "conformant"
            ]
          },
          "mcp_servers": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "conformance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "pack_digest",
              "servers",
              "cases",
              "detail"
            ],
            "properties": {
              "status": {
                "const": "conformant"
              },
              "pack_digest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "detail": {
                "const": ""
              },
              "servers": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "tools",
                    "tools_digest"
                  ],
                  "properties": {
                    "tools": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "uniqueItems": true
                    },
                    "tools_digest": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  }
                }
              },
              "cases": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "index",
                    "tool",
                    "expect",
                    "actual",
                    "passed"
                  ],
                  "properties": {
                    "index": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "tool": {
                      "type": "string"
                    },
                    "expect": {
                      "enum": [
                        "ok",
                        "error"
                      ]
                    },
                    "actual": {
                      "enum": [
                        "ok",
                        "error"
                      ]
                    },
                    "passed": {
                      "const": true
                    }
                  }
                }
              }
            }
          },
          "network": {
            "enum": [
              "none",
              "allowlist",
              "general-http"
            ]
          },
          "hosts": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "env": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z_][A-Z0-9_]*$"
            },
            "uniqueItems": true
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "conformant"
                }
              }
            },
            "then": {
              "required": [
                "conformance"
              ],
              "properties": {
                "conformance": {
                  "required": [
                    "status",
                    "pack_digest",
                    "servers",
                    "cases"
                  ],
                  "properties": {
                    "status": {
                      "const": "conformant"
                    }
                  }
                }
              }
            },
            "else": {
              "not": {
                "required": [
                  "conformance"
                ]
              }
            }
          }
        ]
      }
    },
    "deployment_hints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "static_audit": {
      "type": "object",
      "description": "Written by forge.audit; present exactly when audit.static is not not_run.",
      "additionalProperties": false,
      "required": [
        "strict",
        "findings",
        "thclaws_validate"
      ],
      "properties": {
        "strict": {
          "type": "boolean"
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rule",
              "severity",
              "message"
            ],
            "properties": {
              "rule": {
                "type": "string",
                "minLength": 1
              },
              "severity": {
                "enum": [
                  "error",
                  "warning"
                ]
              },
              "message": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "thclaws_validate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "version",
            "detail"
          ],
          "properties": {
            "status": {
              "enum": [
                "passed",
                "failed",
                "skipped"
              ]
            },
            "version": {
              "type": [
                "string",
                "null"
              ]
            },
            "detail": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "audit": {
            "properties": {
              "static": {
                "const": "not_run"
              }
            }
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "static_audit"
          ]
        }
      },
      "else": {
        "required": [
          "static_audit"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "package_status": {
            "const": "draft"
          }
        }
      },
      "then": {
        "properties": {
          "audit": {
            "properties": {
              "spec": {
                "const": "passed"
              },
              "manifest": {
                "const": "passed"
              },
              "static": {
                "const": "passed"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "static_audit"
        ],
        "properties": {
          "static_audit": {
            "properties": {
              "thclaws_validate": {
                "properties": {
                  "status": {
                    "const": "passed"
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "audit": {
            "properties": {
              "manifest": {
                "const": "passed"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "static_audit"
        ],
        "properties": {
          "static_audit": {
            "properties": {
              "thclaws_validate": {
                "properties": {
                  "status": {
                    "const": "failed"
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "audit": {
            "properties": {
              "manifest": {
                "const": "failed"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "static_audit"
        ],
        "properties": {
          "static_audit": {
            "properties": {
              "thclaws_validate": {
                "properties": {
                  "status": {
                    "const": "skipped"
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "audit": {
            "properties": {
              "manifest": {
                "const": "skipped"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "audit": {
            "properties": {
              "static": {
                "const": "passed"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "static_audit": {
            "properties": {
              "findings": {
                "not": {
                  "contains": {
                    "required": [
                      "severity"
                    ],
                    "properties": {
                      "severity": {
                        "const": "error"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "static_audit"
        ],
        "properties": {
          "audit": {
            "properties": {
              "static": {
                "const": "passed"
              }
            }
          },
          "static_audit": {
            "properties": {
              "strict": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "static_audit": {
            "properties": {
              "findings": {
                "maxItems": 0
              }
            }
          }
        }
      }
    }
  ]
}
