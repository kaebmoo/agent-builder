# Rendered by scripts/render_launcher.py from atlas-register.json (M18a). Re-render instead of editing by hand.
# Package {{ name }}{% if archive %} ({{ archive }}){% endif %}: WorkingDirectory = deployment.daemon_cwd, package at {{ package_root }}.
# Secret values live only in {{ env_file }} (mode 0600, owner thclaws); it must define: {{ env_names | join(', ') }}.
# See docs/deploy-runbook.md. Nothing here verifies the deployment; deployment_verified stays false in the export.
[Unit]
Description=thClaws daemon for Atlas package {{ name }}
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=thclaws
Group=thclaws
WorkingDirectory={{ daemon_cwd }}
EnvironmentFile={{ env_file }}
{% for key, value in fixed_env.items() %}
Environment={{ key }}={{ value }}
{% endfor %}
ExecStart={{ thclaws_bin }} --serve --bind {{ bind }} --port {{ port }}
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
