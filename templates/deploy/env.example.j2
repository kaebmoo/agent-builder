# {{ name }}.env.example: copy to {{ env_file }} (mode 0600, owner thclaws) and fill every value there.
# Rendered by scripts/render_launcher.py from atlas-register.json (M18a): names only, never values.
# Names = daemon token + MCP spawn switch + deployment.env of the export. Never commit the filled file.
{% for key in env_names %}
{{ key }}=
{% endfor %}
# Provider credential for node_template.model = {{ model }}: add the variable names your provider needs
# (OPENAI_API_KEY for gpt-* via OpenAI; OPENAI_COMPAT_API_KEY and OPENAI_COMPAT_BASE_URL for oai/* models).
# THCLAWS_MCP_ALLOW_ALL set to 1 lets the daemon spawn every server in .thclaws/mcp.json ({{ mcp_servers | join(', ') or 'none' }});
# to use an allowlist instead, delete that line and put the full command line of each server in
# ~/.config/thclaws/mcp_allowlist.json of the thclaws user (DESIGN §4 M17 item 4).
# Do not add THCLAWS_PROJECT_ROOT or THCLAWS_OFFICE_APPS: both override the audited package settings.
# Nothing here verifies the deployment; deployment_verified stays false in the export.
